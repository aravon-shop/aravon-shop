# ============================================================
# ARAVON SHOP - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================

# SERVER CONFIGURATION
NODE_ENV=production
PORT=3000
SHOP_NAME=Aravon Shop
CURRENCY=eur
PUBLIC_BASE_URL=https://shop.aravon.com
LOG_LEVEL=info

# STRIPE CONFIGURATION
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# FIREBASE ADMIN CONFIGURATION
FIREBASE_PROJECT_ID=aravon-shop-48fdd
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@aravon-shop-48fdd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC7VJTUt9Us8cKjMzEfYyjiWA4..."

# SECURITY
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
ADMIN_JWT_EXPIRY=7d
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=100
CHECKOUT_RATE_LIMIT_MAX_REQUESTS=10

# DATABASE
FIRESTORE_RETRY_ATTEMPTS=3
FIRESTORE_RETRY_DELAY_MS=1000

# MONITORING & LOGGING
SENTRY_DSN=https://xxx@sentry.io/xxx
MORGAN_FORMAT=combined

# CORS CONFIGURATION
CORS_ORIGIN=https://shop.aravon.com
CORS_CREDENTIALS=true

# FEATURE FLAGS
ENABLE_PAYMENT_RETRY=true
ENABLE_IDEMPOTENCY_CHECK=true
ENABLE_AUDIT_LOGGING=true
ENABLE_WEBHOOK_SIGNATURE_VERIFICATION=true
