{
  "site": {
    "name": "Aravon Shop",
    "appearance": "light",
    "fontFamily": "Inter, sans-serif"
  },

  "colors": {
    "primary": "#111111",
    "secondary": "#666666",
    "accent": "#111111",

    "background": "#ffffff",
    "surface": "#f8f8f8",
    "card": "#ffffff",

    "text": "#111111",
    "textSecondary": "#666666",
    "muted": "#888888",

    "border": "#e5e5e5",

    "buttonBackground": "#111111",
    "buttonText": "#ffffff",
    "buttonHover": "#333333",

    "headerBackground": "#ffffff",
    "headerText": "#111111",

    "footerBackground": "#111111",
    "footerText": "#ffffff",

    "success": "#198754",
    "warning": "#f59e0b",
    "danger": "#dc3545",
    "info": "#0d6efd"
  },

  "fonts": {
    "family": "Inter, sans-serif",
    "heading": "Inter, sans-serif",
    "body": "Inter, sans-serif",

    "weights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },

  "buttons": {
    "borderRadius": "6px",
    "padding": "12px 20px",
    "fontSize": "14px",
    "fontWeight": 600,
    "textTransform": "none"
  },

  "productCards": {
    "background": "#ffffff",
    "border": "1px solid #e5e5e5",
    "borderRadius": "8px",
    "imageBackground": "#f5f5f5",

    "titleColor": "#111111",
    "priceColor": "#111111",
    "brandColor": "#777777",

    "hover": {
      "enabled": true,
      "shadow": "0 8px 24px rgba(0, 0, 0, 0.08)",
      "transform": "translateY(-2px)"
    }
  },

  "header": {
    "background": "#ffffff",
    "textColor": "#111111",
    "borderColor": "#e5e5e5",

    "logo": {
      "text": "Aravon Shop",
      "fontSize": "24px",
      "fontWeight": 700
    },

    "search": {
      "enabled": true,
      "background": "#f7f7f7",
      "borderColor": "#e5e5e5",
      "textColor": "#111111",
      "placeholderColor": "#888888",
      "borderRadius": "6px"
    },

    "cart": {
      "enabled": true,
      "badgeBackground": "#dc3545",
      "badgeText": "#ffffff"
    },

    "mobileMenu": {
      "enabled": true
    }
  },

  "navigation": {
    "textColor": "#111111",
    "hoverColor": "#666666",
    "fontSize": "14px",
    "fontWeight": 500
  },

  "banner": {
    "enabled": true,
    "overlay": "rgba(0, 0, 0, 0.15)",
    "titleColor": "#ffffff",
    "textColor": "#ffffff",
    "buttonBackground": "#ffffff",
    "buttonText": "#111111"
  },

  "categoryBar": {
    "background": "#ffffff",
    "textColor": "#111111",
    "activeColor": "#111111",
    "borderColor": "#e5e5e5"
  },

  "filters": {
    "background": "#ffffff",
    "textColor": "#111111",
    "borderColor": "#e5e5e5",
    "borderRadius": "6px"
  },

  "footer": {
    "background": "#111111",
    "textColor": "#ffffff",
    "mutedTextColor": "#bbbbbb",
    "borderColor": "#333333",

    "links": {
      "color": "#ffffff",
      "hoverColor": "#cccccc"
    }
  },

  "layout": {
    "maxWidth": "1400px",

    "desktop": {
      "productsPerRow": 5,
      "gap": "20px"
    },

    "tablet": {
      "productsPerRow": 3,
      "gap": "16px"
    },

    "mobile": {
      "productsPerRow": 2,
      "gap": "12px"
    }
  },

  "spacing": {
    "section": "40px",
    "container": "20px",
    "card": "16px"
  },

  "appearance": {
    "default": "light",

    "light": {
      "background": "#ffffff",
      "surface": "#f8f8f8",
      "text": "#111111"
    },

    "dark": {
      "background": "#111111",
      "surface": "#1c1c1c",
      "text": "#ffffff"
    }
  },

  "animations": {
    "enabled": true,
    "transition": "0.2s ease"
  },

  "responsive": {
    "mobileMenuBreakpoint": "768px"
  }
}